{
  "_genere_par": "node siege/droits.js — ne pas modifier à la main : Siège › Droits",
  "permissions": {
    "deny": [
      "Read(~/.siege/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)"
    ],
    "allow": [
      "Bash(node siege/backlog.js:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/siege/garde.js\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/siege/garde.js\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/siege/garde.js\""
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "node siege/backlog.js *",
      "node siege/github.js *",
      "node siege/exception.js *",
      "node siege/demande.js *",
      "node siege/filiale.js *",
      "node siege/agent.js *"
    ],
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "*.githubusercontent.com",
        "api.notion.com",
        "slack.com",
        "api.slack.com",
        "hooks.slack.com",
        "registry.npmjs.org",
        "repo.maven.apache.org",
        "repo1.maven.org",
        "central.sonatype.com",
        "plugins.gradle.org",
        "services.gradle.org",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/.siege",
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/.netrc"
      ],
      "denyWrite": [
        "./droits",
        "./.claude",
        "./siege",
        "./portfolio/features.json",
        "./portfolio/bugs.json",
        "./portfolio/commentaires.json",
        "./portfolio/source-backlog.json"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "NOTION_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        }
      ]
    }
  }
}
